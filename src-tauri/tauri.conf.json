{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD极简阅读",
  "version": "0.1.7",
  "identifier": "com.onlymd.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MD极简阅读",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "maxWidth": 800,
        "minHeight": 600,
        "maxHeight": 600,
        "create": false,
        "backgroundColor": "#EDE4D7",
        "visible": false,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$TEMP/**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "template": "wix/main.wxs",
        "fragmentPaths": ["wix/markdown-default-app.wxs"],
        "componentRefs": ["MarkdownDefaultAppRegistration"]
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "name": "MD极简阅读 Markdown 文档",
        "description": "Markdown document for MD极简阅读",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
