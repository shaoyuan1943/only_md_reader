{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "reader-*", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-maximize",
    "opener:default",
    "dialog:allow-open"
  ]
}
